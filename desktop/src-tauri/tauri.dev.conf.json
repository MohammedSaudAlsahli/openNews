{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openNews Dev",
  "identifier": "com.opennews.development",
  "build": {
    "beforeDevCommand": "npm run dev:isolated",
    "beforeBuildCommand": "npm run build:isolated"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "openNews Dev",
        "width": 1320,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
