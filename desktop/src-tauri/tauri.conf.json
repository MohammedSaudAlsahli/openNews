{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStudio Preview",
  "version": "0.3.0-preview.1",
  "identifier": "com.editorialintelligence.studio.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenStudio Preview",
        "width": 1320,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
