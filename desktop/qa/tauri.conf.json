{
  "identifier": "com.opennews.ui-qa",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "openNews Dev QA",
        "width": 1320,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "productName": "openNews Dev QA",
  "build": {
    "beforeDevCommand": "npm run dev:isolated",
    "beforeBuildCommand": "npm run build:isolated"
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
