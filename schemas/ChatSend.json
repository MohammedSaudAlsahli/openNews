{
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "message": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "profile_id": {
      "format": "uuid",
      "title": "Profile Id",
      "type": "string"
    },
    "model_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "consent": {
      "default": false,
      "title": "Consent",
      "type": "boolean"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "article_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Article Ids",
      "type": "array"
    },
    "include_news": {
      "default": true,
      "title": "Include News",
      "type": "boolean"
    },
    "research_web": {
      "default": false,
      "title": "Research Web",
      "type": "boolean"
    },
    "format": {
      "default": "discussion",
      "enum": [
        "discussion",
        "x_posts",
        "youtube_long",
        "tiktok"
      ],
      "title": "Format",
      "type": "string"
    },
    "target_seconds": {
      "anyOf": [
        {
          "maximum": 7200,
          "minimum": 10,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Seconds"
    },
    "days": {
      "default": 7,
      "maximum": 31,
      "minimum": 1,
      "title": "Days",
      "type": "integer"
    },
    "draft_title": {
      "default": "",
      "maxLength": 300,
      "title": "Draft Title",
      "type": "string"
    },
    "draft_text": {
      "default": "",
      "maxLength": 60000,
      "title": "Draft Text",
      "type": "string"
    }
